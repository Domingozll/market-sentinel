{
  "name": "market-sentinel",
  "version": "1.0.0",
  "description": "Local-first OKX market indicator monitor with deterministic rules, Discord alerts, and an audit trail.",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "check": "npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "okx",
    "market-data",
    "technical-analysis",
    "bollinger-bands",
    "kdj",
    "rsi",
    "macd",
    "discord-webhook",
    "market-monitor",
    "trading-tools",
    "typescript",
    "react",
    "sqlite"
  ],
  "author": "Domingozll",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "fastify": "^5.12.8",
    "https-proxy-agent": "^7.0.6",
    "undici": "^7.30.2",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Domingozll/market-sentinel.git"
  },
  "homepage": "https://github.com/Domingozll/market-sentinel#readme",
  "bugs": {
    "url": "https://github.com/Domingozll/market-sentinel/issues"
  },
  "packageManager": "npm@11.21.1"
}
