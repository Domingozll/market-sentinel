# Local server
# Docker published interface: 127.0.0.1 = local only, 0.0.0.0 = trusted LAN.
BIND_HOST=127.0.0.1
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
APP_BASE_URL=http://127.0.0.1:8787

# OKX public endpoints (no API key required)
OKX_REST_BASE=https://openapi.okx.com
OKX_WS_URL=wss://ws.okx.com/ws/v5/business

# Optional bootstrapping defaults. They can also be set in the UI.
PROXY_URL=
DISCORD_WEBHOOK_URL=
TZ=Asia/Shanghai
LOG_LEVEL=info
